    /// @dev GF(2^128) multiplication in the flat basis (exposed for the test harness).
    function gmulFlat(uint256 px, uint256 py) internal pure returns (uint256 out) {
        assembly {
            // carry-less multiply of two 128-bit polynomials via masked integer MULs, then reduce
            function gmul(ga, gb) -> r {
                let a0 := and(ga, 0x8421084210842108421084210842108421084210842108421084210842108421)
                let a1 := and(ga, 0x0842108421084210842108421084210842108421084210842108421084210842)
                let a2 := and(ga, 0x1084210842108421084210842108421084210842108421084210842108421084)
                let a3 := and(ga, 0x2108421084210842108421084210842108421084210842108421084210842108)
                let a4 := and(ga, 0x4210842108421084210842108421084210842108421084210842108421084210)
                let b0 := and(gb, 0x8421084210842108421084210842108421084210842108421084210842108421)
                let b1 := and(gb, 0x0842108421084210842108421084210842108421084210842108421084210842)
                let b2 := and(gb, 0x1084210842108421084210842108421084210842108421084210842108421084)
                let b3 := and(gb, 0x2108421084210842108421084210842108421084210842108421084210842108)
                let b4 := and(gb, 0x4210842108421084210842108421084210842108421084210842108421084210)
                r := and(xor(xor(mul(a0, b0), mul(a1, b4)), xor(xor(mul(a2, b3), mul(a3, b2)), mul(a4, b1))), 0x8421084210842108421084210842108421084210842108421084210842108421)
                r := or(r, and(xor(xor(mul(a0, b1), mul(a1, b0)), xor(xor(mul(a2, b4), mul(a3, b3)), mul(a4, b2))), 0x0842108421084210842108421084210842108421084210842108421084210842))
                r := or(r, and(xor(xor(mul(a0, b2), mul(a1, b1)), xor(xor(mul(a2, b0), mul(a3, b4)), mul(a4, b3))), 0x1084210842108421084210842108421084210842108421084210842108421084))
                r := or(r, and(xor(xor(mul(a0, b3), mul(a1, b2)), xor(xor(mul(a2, b1), mul(a3, b0)), mul(a4, b4))), 0x2108421084210842108421084210842108421084210842108421084210842108))
                r := or(r, and(xor(xor(mul(a0, b4), mul(a1, b3)), xor(xor(mul(a2, b2), mul(a3, b1)), mul(a4, b0))), 0x4210842108421084210842108421084210842108421084210842108421084210))
                // reduce mod x^128 + x^7 + x^2 + x + 1 (deg r <= 254): two folds of the high half
                let h := shr(128, r)
                r := xor(and(r, 0xffffffffffffffffffffffffffffffff), xor(xor(h, shl(1, h)), xor(shl(2, h), shl(7, h))))
                h := shr(128, r)
                r := xor(and(r, 0xffffffffffffffffffffffffffffffff), xor(xor(h, shl(1, h)), xor(shl(2, h), shl(7, h))))
            }
            // squaring: spread bit i to bit 2i (128 -> 256 bits), then reduce
            function gsqr(ga) -> r {
                let x := ga
                x := and(or(x, shl(64, x)), 0x0000000000000000ffffffffffffffff0000000000000000ffffffffffffffff)
                x := and(or(x, shl(32, x)), 0x00000000ffffffff00000000ffffffff00000000ffffffff00000000ffffffff)
                x := and(or(x, shl(16, x)), 0x0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff)
                x := and(or(x, shl(8, x)), 0x00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff)
                x := and(or(x, shl(4, x)), 0x0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f)
                x := and(or(x, shl(2, x)), 0x3333333333333333333333333333333333333333333333333333333333333333)
                x := and(or(x, shl(1, x)), 0x5555555555555555555555555555555555555555555555555555555555555555)
                let h := shr(128, x)
                r := xor(and(x, 0xffffffffffffffffffffffffffffffff), xor(xor(h, shl(1, h)), xor(shl(2, h), shl(7, h))))
                h := shr(128, r)
                r := xor(and(r, 0xffffffffffffffffffffffffffffffff), xor(xor(h, shl(1, h)), xor(shl(2, h), shl(7, h))))
            }
            out := gmul(px, py)
        }
    }

