+/// Q2 / N2 control (noid-swap scratch copy; not upstream code).
+/// Component R1CS = spine_region_data_from_wires + views + policy + partition +
+/// execution for one HTLC close. Shows what the main equations alone decide.
+#[cfg(test)]
+pub(in crate::acceptance) mod q2_n2_control {
+    use super::*;
+    use crate::acceptance::history_step::v2::V2Config;
+    use noid_chain::consensus::forks::{ForkSchedule, V2Activation};
+    use noid_poseidon2b::primitives::Address;
+    use noid_tx::{
+        experimental_object::{
+            integer_program::EMPTY_PROGRAM, transaction_contexts, ObjectOpening, ObjectRules,
+        },
+        output_bitmap_bit, TxBody, TxInput, TxOutput, TxPage, PAGED_SPEND_CONTRACT_BIT,
+        PAGED_SPEND_END_BIT, PAGED_SPEND_START_BIT, PAGED_SPEND_TERMINAL_BIT,
+    };
+
+    thread_local! {
+        pub(in crate::acceptance) static FORGED_OLD_ROOT: std::cell::Cell<Option<[F128; 2]>> =
+            const { std::cell::Cell::new(None) };
+    }
+
+    const HEIGHT: u64 = 299;
+    const DEADLINE: u64 = 300;
+
+    fn htlc(claim_recipient: Address) -> ObjectOpening {
+        ObjectOpening {
+            program: EMPTY_PROGRAM,
+            state: Block128(0),
+            claim_authority: Address([0xA5; 32]),
+            recovery_authority: Address([0xA1; 32]),
+            deadline: DEADLINE,
+            claim_recipient,
+            recovery_recipient: Address([0xA1; 32]),
+            rules: ObjectRules {
+                max_fee: 50_000,
+                min_retained: 0,
+                max_payout: 0,
+                modes: 10,
+            },
+        }
+    }
+
+    fn close_body(funded_root: Address, pay_to: Address) -> TxBody {
+        let mut inputs = [TxInput::dummy(); 8];
+        inputs[0] = TxInput {
+            slot_index: 1,
+            amount: 1_000_000,
+            creation_id: 3,
+        };
+        TxBody {
+            epoch_anchor: [5; 32],
+            fee: 6_000,
+            input_owner: funded_root,
+            inputs,
+            outputs: [
+                TxOutput {
+                    slot_index: 2,
+                    amount: 994_000,
+                    owner: pay_to,
+                },
+                TxOutput::dummy(),
+            ],
+            validity_bitmap: 1
+                | output_bitmap_bit(0)
+                | PAGED_SPEND_START_BIT
+                | PAGED_SPEND_END_BIT
+                | PAGED_SPEND_CONTRACT_BIT
+                | PAGED_SPEND_TERMINAL_BIT,
+            is_coinbase: false,
+        }
+    }
+
+    /// Returns (satisfied, structural digest).
+    fn run(funded: &ObjectOpening, claimed: &ObjectOpening, pay_to: Address) -> (bool, [u8; 32]) {
+        let pages = 25;
+        let capacity = 16;
+        let config = V2Config::with_limits(
+            23,
+            pages,
+            pages * 8,
+            capacity,
+            ForkSchedule::new(Some(5), V2Activation::new(10, 30)).unwrap(),
+        )
+        .unwrap();
+        let mut bodies = vec![noid_gkr::ghost_tx::ghost_tx_body(); pages + 1];
+        let body = close_body(funded.root(), pay_to);
+        let next = claimed.execute(&body, HEIGHT).unwrap();
+        bodies[1] = body.clone();
+        let contracts = vec![V2ContractComponentInput {
+            body_index: 1,
+            live: true,
+            program: claimed.program,
+            current: claimed.state,
+            contexts: transaction_contexts(&body),
+            next,
+            controller: claimed.claim_authority.as_fields(),
+            refund_authority: claimed.recovery_authority.as_fields(),
+            terminal: true,
+            deadline: claimed.deadline,
+            claim_recipient: claimed.claim_recipient.as_fields(),
+            refund_recipient: claimed.recovery_recipient.as_fields(),
+            rules: claimed.rules,
+        }];
+        let natives = bodies
+            .iter()
+            .map(noid_gkr::spine_statement::spine_inputs_from_body)
+            .collect::<Vec<_>>();
+        let hashes = vec![[Block128(0); 2]; natives.len()];
+        let mut b = FieldR1csBuilder::new();
+        let prefix = LinExpr::from_wire(b.alloc_bool(false));
+        let spines = natives
+            .iter()
+            .map(|n| SpineInputsTrace::alloc(&mut b, n))
+            .collect::<Vec<_>>();
+        let hash_wires = hashes
+            .iter()
+            .map(|pair| pair.map(|value| alloc_block(&mut b, value)))
+            .collect::<Vec<_>>();
+        let raw = spine_region_data_from_wires(
+            &mut b,
+            &natives,
+            &hashes,
+            &spines,
+            &hash_wires,
+            &contracts,
+            1,
+            BlockRelationProfile::ScheduledV2(config),
+        );
+        let views = select_v2_contract_views(&mut b, &raw, &prefix, capacity);
+        let height = alloc_block(&mut b, Block128(HEIGHT as u128));
+        let height: [Wire; 64] = range_check_bits(&mut b, &height, 64).try_into().unwrap();
+        let mut surfaces = Vec::new();
+        for index in 0..capacity {
+            let live = alloc_block(&mut b, Block128(u128::from(index == 0)));
+            surfaces.push(bind_user_action_surface_for_profile(
+                &mut b,
+                &spines[1 + index],
+                &live,
+                true,
+            ));
+        }
+        let policy = bind_v2_contract_policy(&mut b, &views, &height);
+        bind_v2_contract_partition(&mut b, &surfaces, &views, true);
+        bind_v2_contract_execution(&mut b, &spines[1..], &surfaces, &views, &policy, false);
+        let (matrix, witness) = b.build();
+        (
+            matrix.satisfies(&witness),
+            matrix.structural_statement_digest(),
+        )
+    }
+
+    #[test]
+    fn q2_n2_control_main_equations_alone() {
+        let bob = Address([0xB0; 32]);
+        let mallory = Address([0x3A; 32]);
+        let honest = htlc(bob);
+        let lying = htlc(mallory);
+        let native_ok = honest.check_call(
+            &TxPage { body: close_body(honest.root(), bob) },
+            HEIGHT,
+        );
+        let native_route_a = honest.check_call(
+            &TxPage { body: close_body(honest.root(), mallory) },
+            HEIGHT,
+        );
+        let native_lying = lying.check_call(
+            &TxPage { body: close_body(honest.root(), mallory) },
+            HEIGHT,
+        );
+        println!("Q2-N2 control native check_call: honest={native_ok:?} routeA={native_route_a:?} lying={native_lying:?}");
+
+        let (ok_honest, digest) = run(&honest, &honest, bob);
+        println!("Q2-N2 control 1 honest opening, pays Bob: satisfied={ok_honest}");
+        let (ok_route_a, d_a) = run(&honest, &honest, mallory);
+        println!("Q2-N2 control 2 honest opening, pays Mallory (route A): satisfied={ok_route_a}");
+        let (ok_lying, d_l) = run(&honest, &lying, mallory);
+        println!("Q2-N2 control 3 lying opening (claim_recipient=Mallory), old-root wire computed honestly, pays Mallory: satisfied={ok_lying}");
+        let forged_root = honest.root().as_fields().map(flat_of);
+        FORGED_OLD_ROOT.with(|cell| cell.set(Some(forged_root)));
+        let (ok_forged, d_f) = run(&honest, &lying, mallory);
+        FORGED_OLD_ROOT.with(|cell| cell.set(None));
+        println!("Q2-N2 control 4 lying opening + old-root wire forced to the funded root, pays Mallory: satisfied={ok_forged}");
+        let same = digest == d_a && digest == d_l && digest == d_f;
+        println!("Q2-N2 control all four matrices identical (structural digest): {same}");
+
+        assert!(native_ok.is_ok());
+        assert!(ok_honest);
+        assert!(!ok_route_a);
+        assert!(!ok_lying);
+        // The main equations alone accept the forgery: the binding must come from
+        // the Meta-A sponge table and its sidecar (walk_a q2_n2 test).
+        assert!(ok_forged);
+        assert!(same);
+    }
+}
