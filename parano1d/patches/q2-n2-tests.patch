+            results.push(("b2", r.is_ok()));
+
+            // (c1) Bob policy rows, the two claim-recipient input cells := Mallory.
+            let (mut c1, _) = fresh(&honest);
+            c1.committed[META_IN0 + 1][r3] = mallory_lanes[0];
+            c1.committed[META_IN0][r4] = mallory_lanes[1];
+            let r = prove_and_verify(&c1);
+            println!("Q2-N2 (c1) funded-root table, claim-recipient input cells := Mallory: {r:?}");
+            results.push(("c1", r.is_ok()));
+
+            // (c2) as c1, and the internal permutation inputs absorb Mallory consistently.
+            let (mut c2, _) = fresh(&honest);
+            c2.committed[META_IN0 + 1][r3] = mallory_lanes[0];
+            c2.committed[META_IN0][r4] = mallory_lanes[1];
+            c2.s0[1][r3] = c2.s0[1][r3] + bob_lanes[0] + mallory_lanes[0];
+            c2.s0[0][r4] = c2.s0[0][r4] + bob_lanes[1] + mallory_lanes[1];
+            let r = prove_and_verify(&c2);
+            println!("Q2-N2 (c2) c1 + internal s0 absorbs Mallory: {r:?}");
+            results.push(("c2", r.is_ok()));
+
+            println!("Q2-N2 summary (case, accepted): {results:?}");
+            assert!(results[0].1, "honest case must verify");
+            for (case, accepted) in &results[1..] {
+                assert!(!accepted, "forged case {case} was ACCEPTED");
+            }
+        }
+    }
 }
