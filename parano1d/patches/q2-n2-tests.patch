+            assert_eq!(honest_fx.committed[META_IN0][r4], bob_lanes[1]);
+            let (lying_check, _) = fresh(&lying);
+            for lane in 0..2 {
+                assert_eq!(lying_check.committed[META_C0 + lane][old], lying_root_lanes[lane]);
+            }
