+    /// Q2 / N2 (noid-swap scratch copy; not upstream code): a forged contract
+    /// opening cannot reach the funded root through the object Meta-A table.
+    mod q2_n2 {
+        use super::super::*;
+        use super::*;
+        use noid_core::Block128;
+        use noid_ivc_core::deep_chain::spine::{
+            build_spine_instance_columns_with_contract, SpineContractInstanceFlat,
+            SPINE_CONTRACT_OLD_OBJECT_BASE, SPINE_CONTRACT_POLICY_BASE,
+        };
+        use noid_poseidon2b::primitives::Address;
+        use noid_tx::experimental_object::{
+            integer_program::EMPTY_PROGRAM, ObjectOpening, ObjectRules,
+        };
+
+        fn fl(v: Block128) -> F128 {
+            flat_of_tower_u128(v.0)
+        }
+
+        fn htlc(claim_recipient: Address) -> ObjectOpening {
+            ObjectOpening {
+                program: EMPTY_PROGRAM,
+                state: Block128(0),
+                claim_authority: Address([0xA5; 32]),
+                recovery_authority: Address([0xA1; 32]),
+                deadline: 300,
+                claim_recipient,
+                recovery_recipient: Address([0xA1; 32]),
+                rules: ObjectRules {
+                    max_fee: 50_000,
+                    min_retained: 0,
+                    max_payout: 0,
+                    modes: 10,
+                },
+            }
+        }
+
+        fn flat(o: &ObjectOpening) -> SpineContractInstanceFlat {
+            SpineContractInstanceFlat {
+                program: o.program.map(|pair| pair.map(fl)),
+                current: fl(o.state),
+                next: fl(o.state),
+                controller: o.claim_authority.as_fields().map(fl),
+                refund_authority: o.recovery_authority.as_fields().map(fl),
+                deadline: fl(Block128::from(o.deadline as u128)),
+                claim_recipient: o.claim_recipient.as_fields().map(fl),
+                refund_recipient: o.recovery_recipient.as_fields().map(fl),
+                rules: o.rules.fields().map(fl),
+            }
+        }
+
+        /// Same layout as `meta_fixture_profile(true, true, true)` but with a
+        /// real contract opening. Returns the fixture and the wrap base row.
+        fn object_fixture(contract: &SpineContractInstanceFlat) -> (Fixture, usize) {
+            let descriptor = WalkARegionDescriptor::ObjectMeta {
+                tx_log: 0,
+                exact_state_region_log: Some(1),
+                spine_cap_log: Some(0),
+            };
+            let protocol = canonical_protocol(descriptor).unwrap();
+            let w = 1usize << protocol.w_log;
+            let (ghost_s0, ghost_out) = run_perm([F128::ZERO; 4]);
+            let mut committed = vec![vec![F128::ZERO; w]; WALK_A_META_COMMITTED_COLUMNS];
+            let mut s0: [Vec<F128>; 4] = std::array::from_fn(|lane| vec![ghost_s0[lane]; w]);
+            let mut s_out: [Vec<F128>; 4] =
+                std::array::from_fn(|lane| vec![ghost_out[lane]; w]);
+            for lane in 0..4 {
+                committed[META_C0 + lane].fill(ghost_out[lane]);
+            }
+            let (columns, _) = build_sponge_leaf_columns(
+                &[(F128::new(17, 1), F128::new(19, 2), F128::new(23, 3))],
+                1,
+            );
+            for lane in 0..2 {
+                committed[META_IN0 + lane][..SPONGE_LEAF_SLOTS].copy_from_slice(&columns.in_[lane]);
+            }
+            for lane in 0..4 {
+                committed[META_C0 + lane][..SPONGE_LEAF_SLOTS].copy_from_slice(&columns.c[lane]);
+                s0[lane][..SPONGE_LEAF_SLOTS].copy_from_slice(&columns.s0[lane]);
+                s_out[lane][..SPONGE_LEAF_SLOTS].copy_from_slice(&columns.s_out[lane]);
+            }
+            let instance = SpineInstanceFlat {
+                leaves: std::array::from_fn(|leaf| {
+                    [
+                        F128::new((2 * leaf + 1) as u64, 0xA5),
+                        F128::new((2 * leaf + 2) as u64, 0x5A),
+                    ]
+                }),
+            };
+            let columns = build_spine_instance_columns_with_contract(&instance, Some(contract));
+            let wrap_slots = SPINE_V2_WRAP_SLOTS;
+            let base = protocol.spine_region_base.unwrap();
+            let wrap = base + SPINE_TREE_SLOTS;
+            for lane in 0..2 {
+                committed[META_KID0 + lane][base..base + SPINE_TREE_SLOTS]
+                    .copy_from_slice(&columns.tree_kid[lane]);
+                committed[META_IN0 + lane][wrap..wrap + wrap_slots]
+                    .copy_from_slice(&columns.wrap_in[lane]);
+            }
+            for lane in 0..4 {
+                committed[META_C0 + lane][base..base + SPINE_TREE_SLOTS]
+                    .copy_from_slice(&columns.tree_c[lane]);
+                committed[META_C0 + lane][wrap..wrap + wrap_slots]
+                    .copy_from_slice(&columns.wrap_c[lane]);
+                s0[lane][base..base + SPINE_TREE_SLOTS].copy_from_slice(&columns.tree_s0[lane]);
+                s0[lane][wrap..wrap + wrap_slots].copy_from_slice(&columns.wrap_s0[lane]);
+                s_out[lane][base..base + SPINE_TREE_SLOTS]
+                    .copy_from_slice(&columns.tree_s_out[lane]);
+                s_out[lane][wrap..wrap + wrap_slots].copy_from_slice(&columns.wrap_s_out[lane]);
+            }
+            (
+                Fixture {
+                    descriptor,
+                    committed,
+                    s0,
+                    s_out,
+                },
+                wrap,
+            )
+        }
+
+        fn panic_text(payload: Box<dyn std::any::Any + Send>) -> String {
+            payload
+                .downcast_ref::<String>()
+                .cloned()
+                .or_else(|| payload.downcast_ref::<&str>().map(|s| s.to_string()))
+                .unwrap_or_else(|| "non-string panic".to_owned())
+        }
+
+        /// Commitment-bound path (as `field_trace_case`, object VK): the
+        /// committed columns are the outer witness, the sidecar is proven in
+        /// the post-commit callback and its claims are discharged by the PCS.
+        fn prove_and_verify(fixture: &Fixture) -> Result<(), String> {
+            let mut builder = FieldR1csBuilder::new();
+            let column_len = 1usize << fixture.w_log();
+            while builder.num_wires() % column_len != 0 {
+                builder.alloc_f128(F128::ZERO);
+            }
+            let base = builder.num_wires() / column_len;
+            for column in &fixture.committed {
+                for value in column {
+                    builder.alloc_f128(*value);
+                }
+            }
+            let slices: [WitnessSlice; WALK_A_META_COMMITTED_COLUMNS] =
+                std::array::from_fn(|column| WitnessSlice {
+                    log2_len: fixture.w_log(),
+                    index: base + column,
+                });
+            let (r1cs, z) = builder.build();
+            let params = params(r1cs.m);
+            let vk = WalkARegionVk::new_object_meta([0xC2; 32], 0, Some(1), Some(0), slices)
+                .map_err(|e| format!("vk: {e:?}"))?;
+            let plan = WalkARegionProverPlan::new(&vk, &fixture.s0, &fixture.s_out)
+                .map_err(|e| format!("plan: {e:?}"))?;
+            let spec = PublicIoSpec {
+                io_slice: WitnessSlice {
+                    log2_len: 0,
+                    index: 0,
+                },
+                io_len: 1,
+                claims: Vec::new(),
+            };
+            let io = vec![F128::ONE];
+            let proved = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                let mut prover = FsLaneChallenger::new(FIELD_DOMAIN);
+                prove_field_with_public_io_and_post_commit_context(
+                    &r1cs,
+                    &z,
+                    &params,
+                    &spec,
+                    &io,
+                    &TRACE_CLASS_DIGEST,
+                    &mut prover,
+                    |context| {
+                        let witness = context.witness();
+                        let (sidecar, claims) = plan
+                            .prove(witness, context)
+                            .expect("walk-A sidecar prover returned Err");
+                        context.append_claims(claims);
+                        sidecar
+                    },
+                )
+            }));
+            let (field_proof, sidecar, commitment, _) =
+                proved.map_err(|p| format!("PROVER PANICKED: {}", panic_text(p)))?;
+            let shape = FieldShape::of(&r1cs);
+            let mut verifier = FsLaneChallenger::new(FIELD_DOMAIN);
+            verify_field_deferred_matrix_with_post_commit_context(
+                &shape,
+                &r1cs.statement_digest(),
+                &commitment,
+                &field_proof,
+                &spec,
+                &io,
+                &TRACE_CLASS_DIGEST,
+                &sidecar,
+                &mut verifier,
+                |proof, context| {
+                    let claims =
+                        verify_walk_a_region_sidecar(&vk, context.total_vars(), proof, context)
+                            .map_err(|_| VerifyError::Auxiliary)?;
+                    context.append_claims(claims);
+                    Ok(())
+                },
+            )
+            .map(|_| ())
+            .map_err(|e| format!("VERIFIER REJECTED: {e:?}"))
+        }
+
+        #[test]
+        fn q2_n2_forged_opening_cannot_reach_funded_root() {
+            let bob = Address([0xB0; 32]);
+            let mallory = Address([0x3A; 32]);
+            let honest = htlc(bob);
+            let lying = htlc(mallory);
