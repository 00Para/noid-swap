+            let mallory_lanes = mallory.as_fields().map(fl);
+            assert_ne!(root_lanes, lying_root_lanes);
+
+            let fresh = |o: &ObjectOpening| object_fixture(&flat(o));
+            let (honest_fx, wrap) = fresh(&honest);
+            let old = wrap + SPINE_CONTRACT_OLD_OBJECT_BASE + 1;
+            let r3 = wrap + SPINE_CONTRACT_POLICY_BASE + 3;
+            let r4 = wrap + SPINE_CONTRACT_POLICY_BASE + 4;
+            println!("Q2-N2 rows: wrap={wrap} old_root_row={old} claim_rcpt_rows={r3},{r4}");
+            // Table reproduces the native ObjectOpening::root() and holds the recipient.
