+                b1.committed[META_C0 + lane][old] = root_lanes[lane];
+            }
+            let r = prove_and_verify(&b1);
+            println!("Q2-N2 (b1) Mallory policy + committed old-root cells := funded root: {r:?}");
+            results.push(("b1", r.is_ok()));
+
+            // (b2) as b1, and the prover's internal permutation-output trace lies too.
